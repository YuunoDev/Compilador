START
READ categoria "Dame la categoria del trabajador: " [INT]
READ sueldo "Dame el sueldo del trabajador: " [INT]
t1 = categoria == 1
IF_FALSE t1 GOTO L1
t2 = sueldo * 15
t3 = t2 / 100
aumento = t3
LABEL L1
t4 = categoria == 2
IF_FALSE t4 GOTO L2
t5 = sueldo * 10
t6 = t5 / 100
aumento = t6
LABEL L2
t7 = categoria == 3
IF_FALSE t7 GOTO L3
t8 = sueldo * 8
t9 = t8 / 100
aumento = t9
LABEL L3
t10 = categoria == 4
IF_FALSE t10 GOTO L4
t11 = sueldo * 7
t12 = t11 / 100
aumento = t12
LABEL L4
t13 = categoria >= 5
t14 = categoria <= 0
t15 = t13 || t14
IF_FALSE t15 GOTO L5
PRINT "Categoria no encontrada"
LABEL L5
t16 = sueldo + aumento
sueldo_nuevo = t16
PRINT ""
PRINT "=====RESULTADO====="
PRINT "Categoria: " categoria
PRINT "Sueldo anterior: " sueldo
PRINT "Aumento: " aumento
PRINT "Nuevo sueldo: " sueldo_nuevo
END
