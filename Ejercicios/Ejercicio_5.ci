START
P1 = P2
clave = cant
total1 = total2
total1 = 0
total2 = 0
total3 = 0
total4 = 0
total5 = 0
recaudacion = 0
READ P1 "Ingrese precio localidad 1: "
READ P2 "Ingrese precio localidad 2: "
READ P3 "Ingrese precio localidad 3: "
READ P4 "Ingrese precio localidad 4: "
READ P5 "Ingrese precio localidad 5: "
READ clave "Ingrese clave de localidad (1-5, 0 para terminar): "
LABEL L1
t1 = clave != 0
IF_FALSE t1 GOTO L2
READ cant "Ingrese cantidad de boletos vendidos: "
t2 = clave == 1
IF_FALSE t2 GOTO L3
t3 = cant * P1
importe = t3
GOTO L4
LABEL L3
t4 = clave == 2
IF_FALSE t4 GOTO L5
t5 = cant * P2
importe = t5
GOTO L6
LABEL L5
t6 = clave == 3
IF_FALSE t6 GOTO L7
t7 = cant * P3
importe = t7
GOTO L8
LABEL L7
t8 = clave == 4
IF_FALSE t8 GOTO L9
t9 = cant * P4
importe = t9
GOTO L10
LABEL L9
t10 = clave == 5
IF_FALSE t10 GOTO L11
t11 = cant * P5
importe = t11
GOTO L12
LABEL L11
importe = 0
LABEL L12
LABEL L10
LABEL L8
LABEL L6
LABEL L4
PRINT "Venta -> Clave: " clave "  Cantidad: " cant "  Importe: " importe
t12 = clave == 1
IF_FALSE t12 GOTO L13
t13 = total1 + cant
total1 = t13
GOTO L14
LABEL L13
t14 = clave == 2
IF_FALSE t14 GOTO L15
t15 = total2 + cant
total2 = t15
GOTO L16
LABEL L15
t16 = clave == 3
IF_FALSE t16 GOTO L17
t17 = total3 + cant
total3 = t17
GOTO L18
LABEL L17
t18 = clave == 4
IF_FALSE t18 GOTO L19
t19 = total4 + cant
total4 = t19
GOTO L20
LABEL L19
t20 = clave == 5
IF_FALSE t20 GOTO L21
t21 = total5 + cant
total5 = t21
GOTO L22
LABEL L21
PRINT "Clave inválida, no acumular"
LABEL L22
LABEL L20
LABEL L18
LABEL L16
LABEL L14
t22 = recaudacion + importe
recaudacion = t22
READ clave "Ingrese clave de localidad (1-5, 0 para terminar): "
GOTO L1
LABEL L2
PRINT "=== TOTAL DE BOLETOS VENDIDOS POR TIPO ==="
PRINT "Localidad 1: " total1
PRINT "Localidad 2: " total2
PRINT "Localidad 3: " total3
PRINT "Localidad 4: " total4
PRINT "Localidad 5: " total5
PRINT "Recaudación total del estadio: " recaudacion
m = 129.9
PRINT m
END
